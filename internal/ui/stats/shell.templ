package stats

import (
	"encoding/json"
	"slices"

	"github.com/mach4-braai/gauger-server/internal/ui/chart"
	"github.com/mach4-braai/gauger-server/internal/ui/static"
)

type shell struct {
	Title      string
	Path       string
	Sel        selection
	Repos      []string
	Events     []string
	Live       string
	Version     string
	VersionURL  string
	FeedbackURL string
	Body       templ.Component
}

// navigate follows a[data-nav] links in place; Datastar patches the page.
const navigate = `const a = evt.target.closest('a[data-nav]'); if (a && evt.button === 0 && !(evt.metaKey || evt.ctrlKey || evt.shiftKey || evt.altKey)) { evt.preventDefault(); @get(a.getAttribute('href')) }`

// liveInit opens a page's event stream. Cleanup cancellation ends the old
// stream when a navigation gives #live a new URL, and retrying always
// reconnects after the server closes a stream cleanly, as when it restarts.
func liveInit(url string) string {
	u, _ := json.Marshal(url)
	return "@get(" + string(u) + ", {retry: 'always', requestCancellation: 'cleanup'})"
}

// liveState maps the events of the #live stream to the chip's state. A
// patch means the stream is up.
const liveState = `const d = evt.detail; if (d.el && d.el.id === 'live') { $_live = {'datastar-patch-elements': 'live', 'retrying': 'retrying', 'retries-failed': 'offline'}[d.type] || $_live }`

// refilter reloads the page in place when an input of the filter form
// changes.
const refilter = `if (evt.target.form && evt.target.form.id === '` + chart.Form + `') ` + applyFilters

// themeScript applies the saved theme before first paint and defines
// gaugerTheme, which the toggle calls to save and apply a new one.
const themeScript = `(function () {
	var key = "gauger-theme", dark = matchMedia("(prefers-color-scheme: dark)");
	function saved() { try { return localStorage.getItem(key); } catch (e) { return null; } }
	function apply(pref) {
		var theme = pref === "light" || pref === "dark" ? pref : dark.matches ? "dark" : "light";
		document.documentElement.dataset.theme = theme;
		document.documentElement.style.colorScheme = theme;
	}
	window.gaugerTheme = function (pref) {
		try { localStorage.setItem(key, pref); } catch (e) {}
		apply(pref);
	};
	dark.addEventListener("change", function () { apply(saved()); });
	apply(saved());
})();`

const feedbackScript = `(function () {
	var key = "gauger-feedback", root = document.documentElement, tick = "\u0060";
	try { if (localStorage.getItem(key) === "on") root.dataset.feedback = "on"; } catch (e) {}
	window.gaugerFeedback = {
		limit: 8000,
		toggle: function () {
			var on = root.dataset.feedback !== "on";
			if (on) root.dataset.feedback = "on"; else delete root.dataset.feedback;
			try { localStorage.setItem(key, on ? "on" : "off"); } catch (e) {}
			return on;
		},
		url: function (d, fb) {
			var lines = ["**Component:** " + fb.component, "**Page:** " + tick + fb.path + tick, "**Build:** " + (d.build || "unknown"), ""];
			if (fb.kind === "bug") lines.push("### Expected", "", fb.expected, "", "### Actual", "", fb.actual);
			else lines.push("### Comment", "", fb.comment);
			return d.issues + "?title=" + encodeURIComponent(fb.title) + "&labels=" + (fb.kind === "bug" ? "bug" : "enhancement") + "&body=" + encodeURIComponent(lines.join("\n"));
		}
	};
})();`

const feedbackLeft = `gaugerFeedback.limit - gaugerFeedback.url(document.getElementById('feedback').dataset, $_fb).length`

const feedbackSubmit = `const d = document.getElementById('feedback'); window.open(gaugerFeedback.url(d.dataset, $_fb), '_blank', 'noopener'); $_fb.comment = ''; $_fb.expected = ''; $_fb.actual = ''; d.close()`

func openFeedback(component string) string {
	c, _ := json.Marshal(component)
	return "const c = document.getElementById('page').dataset.page + ' · ' + " + string(c) + "; if ($_fb.component !== c) { $_fb.component = c; $_fb.title = 'Issue: ' + c; $_fb.comment = ''; $_fb.expected = ''; $_fb.actual = '' } $_fb.path = location.pathname + location.search; document.getElementById('feedback').showModal()"
}

templ layout(sh shell) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ sh.Title } · gauger</title>
			@templ.Raw("<script>" + themeScript + feedbackScript + "</script>")
			<link rel="stylesheet" href={ static.Path("stats.css") }/>
			<script type="module" src={ static.Path("datastar.js") }></script>
		</head>
		<body data-on:click={ navigate } data-on:change={ refilter } data-indicator="_loading">
			<div class="shell-ambient"></div>
			<header class="topbar">
				<label for="nav-open" class="btn topbar-menu" data-variant="ghost" data-icon="true" aria-label="Open navigation">
					@menuIcon()
				</label>
				<a class="topbar-brand" href={ "/stats/" + sh.Sel.query() }>
					@mark()
					<span>gauger</span>
					<span class="topbar-slash">/</span>
					<span class="topbar-title">stats</span>
				</a>
				<div class="topbar-spacer"></div>
				<div class="topbar-actions">
					if sh.VersionURL != "" {
						<a class="topbar-version micro mono" href={ sh.VersionURL } title={ "build " + sh.Version }>{ sh.Version }</a>
					} else if sh.Version != "" {
						<span class="topbar-version micro mono" title={ "build " + sh.Version }>{ sh.Version }</span>
					}
					@liveChip()
					@feedbackToggle()
					@themeToggle()
				</div>
			</header>
			@liveStream(sh.Live)
			<input type="checkbox" id="nav-open" class="nav-open" hidden/>
			<label for="nav-open" class="drawer-scrim nav-scrim"></label>
			@navList(sh.Path, sh.Sel)
			<main class="shell-panel">
				<div class="shell-content">
					@filterBar(sh)
					@pageBody(sh.Title, sh.Body)
				</div>
			</main>
			@feedbackDialog(sh.FeedbackURL, sh.Version)
		</body>
	</html>
}

// pageBody is the element a Datastar request replaces.
templ pageBody(title string, body templ.Component) {
	<div id="page" class="page" data-page={ title } data-class:stale="$_loading">
		@body
	</div>
}

// liveStream is the element whose request is the page's event stream. A
// Datastar navigation patches it with the new page's URL.
templ liveStream(url string) {
	<div id="live" hidden data-init={ liveInit(url) }></div>
}

// liveChip shows the state of the stream. It stays hidden until the stream
// first connects.
templ liveChip() {
	<span
		class="live-chip"
		style="display: none"
		title="Live updates"
		data-signals="{_live: ''}"
		data-show="$_live"
		data-on:datastar-fetch={ liveState }
	>
		<span class="dot" data-attr:data-tone="{live: 'live', retrying: 'warn', offline: 'bad'}[$_live]" data-attr:data-pulse="$_live === 'live' && 'true'"></span>
		<span data-text="{live: 'Live', retrying: 'Reconnecting', offline: 'Offline'}[$_live]"></span>
	</span>
}

// navGroups splits nav into runs of entries that share a group.
func navGroups() [][]navItem {
	var groups [][]navItem
	for i, item := range nav {
		if i == 0 || nav[i-1].group != item.group {
			groups = append(groups, nil)
		}
		groups[len(groups)-1] = append(groups[len(groups)-1], item)
	}
	return groups
}

// navList is the sidebar. Its links carry the shell's filter, so a
// Datastar request patches it along with the page.
templ navList(path string, sel selection) {
	<nav id="nav" class="sidebar" aria-label="Pages">
		@feedbackCorner("Sidebar")
		for _, group := range navGroups() {
			<div class="nav-group">
				<div class="nav-heading">{ group[0].group }</div>
				for _, item := range group {
					if item.path == path {
						<a class="nav-row" href={ item.path + sel.query() } data-active="true" aria-current="page">
							@item.icon()
							<span class="nav-row-label">{ item.label }</span>
						</a>
					} else {
						<a class="nav-row" href={ item.path + sel.query() }>
							@item.icon()
							<span class="nav-row-label">{ item.label }</span>
						</a>
					}
				}
			</div>
		}
		<div class="sidebar-foot micro">
			<a href="/setup">Setup</a>
		</div>
	</nav>
}

templ filterBar(sh shell) {
	<form id={ chart.Form } class="filter-bar" method="get" action={ sh.Path } data-on:submit__prevent={ applyFilters }>
		<select class="input" name="repo" aria-label="Repository">
			<option value="">All repositories</option>
			for _, r := range withSelected(sh.Repos, sh.Sel.Repo) {
				<option value={ r } selected?={ r == sh.Sel.Repo }>{ r }</option>
			}
		</select>
		<select class="input" name="event" aria-label="Event">
			<option value="">All events</option>
			for _, e := range withSelected(sh.Events, sh.Sel.Event) {
				<option value={ e } selected?={ e == sh.Sel.Event }>{ e }</option>
			}
		</select>
		<div class="segmented" role="radiogroup" aria-label="Time range">
			for _, w := range windows {
				<label class="segmented-option" title={ w.prose }>
					<input type="radio" name="range" value={ w.key } checked?={ w.key == sh.Sel.Range }/>
					{ w.label }
				</label>
			}
		</div>
		<noscript><button class="btn" data-size="sm" type="submit">Apply</button></noscript>
		@feedbackButton("Filters")
	</form>
}

// withSelected is options plus selected when the query names something
// the list does not have, so the form shows what the page is filtered by.
func withSelected(options []string, selected string) []string {
	if selected == "" || slices.Contains(options, selected) {
		return options
	}
	return append(slices.Clone(options), selected)
}

templ themeToggle() {
	<button
		type="button"
		class="btn"
		data-variant="ghost"
		data-icon="true"
		aria-label="Switch between system, light and dark theme"
		title="Theme: system, light or dark"
		data-signals="{_theme: localStorage.getItem('gauger-theme') || 'system'}"
		data-on:click="$_theme = {system: 'light', light: 'dark', dark: 'system'}[$_theme] || 'light'; gaugerTheme($_theme)"
	>
		<span data-show="$_theme !== 'light' && $_theme !== 'dark'">
			@monitorIcon()
		</span>
		<span style="display: none" data-show="$_theme === 'light'">
			@sunIcon()
		</span>
		<span style="display: none" data-show="$_theme === 'dark'">
			@moonIcon()
		</span>
	</button>
}

templ feedbackToggle() {
	<button
		type="button"
		class="btn"
		data-variant="ghost"
		data-icon="true"
		aria-label="Feedback mode"
		aria-pressed="false"
		title="Feedback mode: a button on each component drafts a GitHub issue"
		data-signals="{_feedback: document.documentElement.dataset.feedback === 'on'}"
		data-attr:aria-pressed="$_feedback ? 'true' : 'false'"
		data-on:click="$_feedback = gaugerFeedback.toggle()"
	>
		@feedbackIcon()
	</button>
}

templ feedbackButton(component string) {
	<button
		type="button"
		class="btn feedback-btn"
		data-variant="ghost"
		data-icon="true"
		data-size="sm"
		aria-label={ "Give feedback on " + component }
		title={ "Give feedback on " + component }
		data-on:click={ openFeedback(component) }
	>
		@feedbackAddIcon()
	</button>
}

templ feedbackCorner(component string) {
	<div class="feedback-corner">
		@feedbackButton(component)
	</div>
}

templ feedbackDialog(issues, build string) {
	<dialog
		id="feedback"
		class="modal"
		aria-labelledby="feedback-title"
		data-issues={ issues }
		data-build={ build }
		data-signals="{_fb: {component: '', title: '', path: '', kind: 'feedback', comment: '', expected: '', actual: ''}}"
		data-on:click="evt.target === el && el.close()"
	>
		<form class="modal-form" data-on:submit__prevent={ feedbackSubmit }>
			<header class="drawer-header">
				<div class="drawer-titles">
					<input id="feedback-title" class="input modal-title" aria-label="Issue title" required data-bind="_fb.title"/>
					<div class="drawer-subtitle mono truncate" data-text="$_fb.path"></div>
				</div>
				<button type="button" class="btn" data-variant="ghost" data-size="sm" data-on:click="document.getElementById('feedback').close()">Close</button>
			</header>
			<div class="drawer-body">
				<div class="segmented" role="radiogroup" aria-label="Kind" data-size="sm">
					<label class="segmented-option">
						<input type="radio" name="feedback-kind" value="feedback" data-bind="_fb.kind"/>
						Feedback
					</label>
					<label class="segmented-option">
						<input type="radio" name="feedback-kind" value="bug" data-bind="_fb.kind"/>
						Bug
					</label>
				</div>
				<label class="field" data-show="$_fb.kind !== 'bug'">
					<span class="micro">Comment</span>
					<textarea class="input" rows="6" data-bind="_fb.comment"></textarea>
				</label>
				<label class="field" style="display: none" data-show="$_fb.kind === 'bug'">
					<span class="micro">Expected</span>
					<textarea class="input" rows="4" data-bind="_fb.expected"></textarea>
				</label>
				<label class="field" style="display: none" data-show="$_fb.kind === 'bug'">
					<span class="micro">Actual</span>
					<textarea class="input" rows="4" data-bind="_fb.actual"></textarea>
				</label>
			</div>
			<footer class="modal-footer">
				<span class="micro" data-text={ feedbackLeft + " + ' characters left'" }></span>
				<button type="submit" class="btn" data-variant="primary" data-attr:disabled={ feedbackLeft + " < 0" }>Open issue on GitHub</button>
			</footer>
		</form>
	</dialog>
}

templ mark() {
	<svg class="topbar-mark" viewBox="0 0 64 64" width="22" height="22" aria-hidden="true">
		<defs>
			<linearGradient id="gauger-mark" x1="0" y1="0" x2="1" y2="1">
				<stop offset="0" stop-color="var(--accent-a)"></stop>
				<stop offset="1" stop-color="var(--accent-b)"></stop>
			</linearGradient>
		</defs>
		<path fill="none" stroke="url(#gauger-mark)" stroke-width="7" stroke-linecap="round" d="M12 46a22 22 0 1 1 40 0"></path>
		<path stroke="url(#gauger-mark)" stroke-width="7" stroke-linecap="round" d="M32 40 44 22"></path>
	</svg>
}
