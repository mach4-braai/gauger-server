package stats

import "github.com/mach4-braai/gauger-server/internal/ui/chart"

templ stepsIcon() {
	@icon() {
		<line x1="10" x2="14" y1="2" y2="2"></line>
		<line x1="12" x2="15" y1="14" y2="11"></line>
		<circle cx="12" cy="14" r="8"></circle>
	}
}

templ stepsPage(v stepsView) {
	@pageHeader("Steps", v.Description)
	@statGrid(170) {
		for _, t := range v.Tiles {
			@stat(t)
		}
	}
	if v.KeepSort {
		<input type="hidden" form={ chart.Form } name="sort" value={ v.Sort }/>
		<input type="hidden" form={ chart.Form } name="dir" value={ v.Dir }/>
	}
	if v.Empty {
		@card("", "") {
			@emptyState("No steps in this range", "Steps appear once a job in the window has completed.")
		}
	} else {
		<div class="grid grid-2">
			@card("Most minutes", "Top steps by total minutes. Each links to the job of its slowest run.") {
				@chart.BarList(v.Top, 0)
			}
			@card("Setup against work", "Share of step minutes spent in setup, and its share per bucket, UTC.") {
				@chart.ShareBar(v.Split)
				<div style="margin: 10px 0 14px">
					@chart.Legend(v.SplitLegend)
				</div>
				@chart.TimeChart(v.Share)
			}
		</div>
		@card("All steps", v.TableNote) {
			@stepsTable(v)
		}
	}
}

templ stepsTable(v stepsView) {
	<div class="table-wrap">
		<table class="table" data-dense="true">
			<thead>
				<tr>
					for _, h := range v.Heads {
						<th
							data-sortable="true"
							if h.Right {
								data-align="right"
							}
							if h.Dir != "" {
								data-sorted={ h.Dir }
							}
						>
							<a href={ h.Href } data-nav>
								{ h.Label }
								if h.Dir == "desc" {
									<span class="sort-arrow">↓</span>
								} else if h.Dir == "asc" {
									<span class="sort-arrow">↑</span>
								}
							</a>
						</th>
					}
					<th>Minutes per bucket</th>
				</tr>
			</thead>
			<tbody>
				for _, r := range v.Rows {
					<tr data-step={ r.Name }>
						<td data-col="name">
							<a href={ templ.SafeURL(r.JobHref) } data-nav title="The job of the slowest run">{ r.Name }</a>
						</td>
						<td data-col="kind">
							if r.Setup {
								<span class="badge" data-tone="warn">Setup</span>
							} else {
								<span class="badge">Work</span>
							}
						</td>
						<td class="num" data-align="right" data-col="runs">{ r.Runs }</td>
						<td class="num" data-align="right" data-col="total">{ r.Minutes }</td>
						<td class="num" data-align="right" data-col="p50">{ r.P50 }</td>
						<td class="num" data-align="right" data-col="p95">{ r.P95 }</td>
						<td class="num" data-align="right" data-col="failures">
							if r.Failed {
								<span class="tone-bad">{ r.Failures }</span>
							} else {
								{ r.Failures }
							}
						</td>
						<td class="num" data-align="right" data-col="slowest">
							{ r.Slowest }
							if r.GitHubHref != "" {
								<a class="muted" href={ templ.SafeURL(r.GitHubHref) } title="This step on GitHub">step { r.StepNumber }</a>
							} else {
								<span class="muted">step { r.StepNumber }</span>
							}
						</td>
						<td style="width: 140px">
							@chart.Sparkline(r.Spark, stepsHue(r.Setup))
						</td>
					</tr>
				}
			</tbody>
		</table>
	</div>
}
