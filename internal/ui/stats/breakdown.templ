package stats

import (
	"strconv"

	"github.com/mach4-braai/gauger-server/internal/ui/chart"
)

templ breakdownIcon() {
	@icon() {
		<path d="m12.83 2.18a2 2 0 0 0-1.66 0L2.6 6.08a1 1 0 0 0 0 1.83l8.58 3.91a2 2 0 0 0 1.66 0l8.58-3.9a1 1 0 0 0 0-1.83Z"></path>
		<path d="m22 17.65-9.17 4.16a2 2 0 0 1-1.66 0L2 17.65"></path>
		<path d="m22 12.65-9.17 4.16a2 2 0 0 1-1.66 0L2 12.65"></path>
	}
}

templ breakdownPage(v breakdownView) {
	@pageHeader("Breakdown", v.Description)
	<div class="page-actions rise">
		<div class="segmented" role="radiogroup" aria-label="Group by">
			for _, d := range v.Dimensions {
				<label class="segmented-option">
					<input type="radio" form={ chart.Form } name="by" value={ string(d.Key) } checked?={ d.Key == v.By.Key }/>
					{ d.Label }
				</label>
			}
		</div>
		<input type="hidden" form={ chart.Form } name="sort" value={ v.Sort }/>
		<input type="hidden" form={ chart.Form } name="dir" value={ v.Dir }/>
	</div>
	if len(v.Rows) == 0 {
		@card("", "") {
			@emptyState("Nothing to break down in this range", "No runs or jobs started in it.")
		}
	} else {
		@card("Job minutes", "Share of the window's job minutes by "+v.By.Noun) {
			@chart.ShareBar(v.Share)
			<div style="margin-top: 12px">
				@chart.Legend(v.Legend)
			</div>
		}
		@card("", "") {
			<div class="table-wrap">
				<table class="table" data-dense="true">
					<thead>
						<tr>
							for _, c := range v.Columns {
								<th
									data-sortable="true"
									if c.Right {
										data-align="right"
									}
									if c.Sorted != "" {
										data-sorted={ c.Sorted }
									}
									if c.Title != "" {
										title={ c.Title }
									}
								>
									<a href={ templ.SafeURL(c.Href) } data-nav>
										{ c.Label }
										if c.Sorted == "asc" {
											<span class="sort-arrow">↑</span>
										} else if c.Sorted == "desc" {
											<span class="sort-arrow">↓</span>
										}
									</a>
								</th>
							}
							<th>Trend</th>
							<th></th>
						</tr>
					</thead>
					<tbody>
						for _, r := range v.Rows {
							@breakdownRowView(r, v)
						}
					</tbody>
					<tfoot>
						@breakdownTotal(v)
					</tfoot>
				</table>
			</div>
			if v.Hidden > 0 {
				<div class="table-more micro">
					{ chart.Integer(float64(v.Hidden)) } more { v.By.Noun }s. Narrow the filters to see them.
				</div>
			}
		}
	}
}

templ breakdownRowView(r breakdownRow, v breakdownView) {
	<tr data-row>
		<td data-col="name">
			<div class="stack">
				if r.External != "" {
					<a class="cell-primary" href={ templ.SafeURL(r.External) } rel="noreferrer">{ r.Name }</a>
				} else if r.Empty {
					<span class="cell-secondary">(none)</span>
				} else {
					<span class="cell-primary">{ r.Name }</span>
				}
				if r.Sub != "" {
					<span class="cell-secondary truncate">{ r.Sub }</span>
				}
			</div>
		</td>
		<td data-align="right" data-col="runs" data-value={ strconv.FormatInt(r.Runs, 10) }>{ chart.Integer(float64(r.Runs)) }</td>
		<td data-align="right" data-col="jobs" data-value={ strconv.FormatInt(r.Jobs, 10) }>{ chart.Integer(float64(r.Jobs)) }</td>
		<td data-align="right" data-col="minutes" data-value={ strconv.FormatInt(r.Minutes, 10) }>{ chart.Integer(float64(r.Minutes)) }</td>
		<td data-align="right" data-col="spend" data-value={ raw(r.Spend) }
			if r.Unpriced > 0 {
				title={ r.spendTitle() }
			}
		>{ r.spendText() }</td>
		if v.Branch {
			<td data-align="right" data-col="failure" class={ failureTone(r.Failure) }>{ optPercent(r.Failure) }</td>
		} else {
			<td data-align="right" data-col="success">{ optPercent(r.Success) }</td>
		}
		<td data-align="right" data-col="p50">{ optSeconds(r.P50) }</td>
		<td data-align="right" data-col="p95">{ optSeconds(r.P95) }</td>
		<td data-align="right" data-col="queue">{ optSeconds(r.Queue) }</td>
		<td data-col="trend" style="width: 120px">
			@chart.Sparkline(r.Spark, "var(--chart-primary)")
		</td>
		<td>
			if r.RunsHref != "" || r.TrendsHref != "" {
				<span class="row-links">
					if r.RunsHref != "" {
						<a href={ templ.SafeURL(r.RunsHref) } data-nav>Runs</a>
					}
					if r.TrendsHref != "" {
						<a href={ templ.SafeURL(r.TrendsHref) } data-nav>Trends</a>
					}
				</span>
			}
		</td>
	</tr>
}

templ breakdownTotal(v breakdownView) {
	<tr>
		<td class="cell-secondary">Total</td>
		if v.TotalRuns {
			<td data-align="right" data-total="runs" data-value={ strconv.FormatInt(v.Total.Runs, 10) }>{ chart.Integer(float64(v.Total.Runs)) }</td>
		} else {
			<td data-align="right" title="A run counts under each of its jobs.">–</td>
		}
		<td data-align="right" data-total="jobs" data-value={ strconv.FormatInt(v.Total.Jobs, 10) }>{ chart.Integer(float64(v.Total.Jobs)) }</td>
		<td data-align="right" data-total="minutes" data-value={ strconv.FormatInt(v.Total.Minutes, 10) }>{ chart.Integer(float64(v.Total.Minutes)) }</td>
		<td data-align="right" data-total="spend" data-value={ raw(v.Total.Spend) }
			if v.Total.Unpriced > 0 {
				title={ v.Total.spendTitle() }
			}
		>{ chart.USD(v.Total.Spend) }</td>
		<td colspan="6"></td>
	</tr>
}

// failureTone colours a failure rate: red from a fifth of decided runs up.
func failureTone(v *float64) string {
	switch {
	case v == nil:
		return ""
	case *v >= 0.2:
		return "tone-bad"
	case *v >= 0.1:
		return "tone-warn"
	}
	return ""
}
