package chart

import (
	"fmt"
	"strings"
)

// sparkPath scales values into a 100 by 28 box, zero at the bottom.
func sparkPath(values []float64) string {
	top := 0.0
	for _, v := range values {
		top = max(top, v)
	}
	n := len(values)
	var b strings.Builder
	for i := range values {
		x := 50.0
		if n > 1 {
			x = float64(i) * 100 / float64(n-1)
		}
		y := 26.0
		if top > 0 {
			y = 26 - value(values, i)/top*24
		}
		cmd := "L"
		if i == 0 {
			cmd = "M"
		}
		fmt.Fprintf(&b, "%s%.2f,%.2f", cmd, x, y)
	}
	return b.String()
}

// Sparkline is an axis-free trend line for stat tiles and table cells. It
// stretches to its container's width.
templ Sparkline(values []float64, color string) {
	if len(values) > 1 {
		<div class="sparkline">
			<svg viewBox="0 0 100 28" preserveAspectRatio="none" aria-hidden="true">
				<path class="area" d={ sparkPath(values) + "L100,28L0,28Z" } fill={ color }></path>
				<path class="chart-line" d={ sparkPath(values) } stroke={ color }></path>
			</svg>
		</div>
	}
}
